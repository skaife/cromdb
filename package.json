{
  "name": "cromdb-repo",
  "private": true,
  "description": "The CromDB repository. The engine is in packages/engine and is published as cromdb. The driver packages in packages/driver and packages/driver-level-4, the server in packages/server and its admin UI in packages/admin-ui, are private.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/driver",
    "packages/driver-level-4",
    "packages/admin-ui",
    "packages/server"
  ],
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "build": "npm run build -w cromdb -w @cromdb/driver -w @cromdb/driver-level-4 -w @cromdb/admin-ui -w @cromdb/server",
    "typecheck": "npm run typecheck -w cromdb -w @cromdb/driver -w @cromdb/driver-level-4 -w @cromdb/admin-ui -w @cromdb/server",
    "test": "npm test -w cromdb -w @cromdb/driver -w @cromdb/driver-level-4 -w @cromdb/admin-ui -w @cromdb/server",
    "check-pins": "node scripts/check-pins.mjs",
    "test:keycloak": "npm run test:keycloak -w @cromdb/server --",
    "demo:reset": "npm run build && node demo/scripts/reset.ts",
    "demo": "npm run build && node demo/scripts/start.ts",
    "demo:fresh": "npm run build && node demo/scripts/start.ts --fresh"
  }
}
