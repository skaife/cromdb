{
  "name": "cromdb-repo",
  "private": true,
  "description": "The CromDB repository. The engine is in packages/engine and is published as cromdb.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "build": "npm run build -w cromdb",
    "typecheck": "npm run typecheck -w cromdb",
    "test": "npm test -w cromdb",
    "demo:reset": "npm run build && node demo/scripts/reset.ts",
    "demo": "npm run build && node demo/scripts/start.ts",
    "demo:fresh": "npm run build && node demo/scripts/start.ts --fresh"
  }
}
