# CromDB Server settings for docker compose. Copy this file to .env and fill
# it in. See README.md, beside this file.
#
# Everything below except CROMDB_VERSION and TZ is read ONLY on the first
# start, when the data volume is empty, to set the server up. After that
# the settings live in the server's own database: change them in the admin
# UI (Settings), or with "docker compose run --rm cromdb config set".
# An empty value counts as not set.

# The image version to run. "latest" if not set.
CROMDB_VERSION=0.3.0

# The server's time zone, for the daily maintenance hour (3:00 by default).
# UTC if not set. Remove the # to set it.
# TZ=Europe/London

# The server's name, shown to people.
CROMDB_SERVER_NAME=Our CromDB Server

# Where people reach the server: what they type in the browser.
# https://... with TLS here or in a proxy in front; http://localhost:8080
# for a try on this machine.
CROMDB_PUBLIC_URL=http://localhost:8080

# yes to allow a plain http:// public URL or issuer that isn't on this
# machine. Passwords, cookies and data then cross the network unencrypted:
# only on a network you trust.
CROMDB_ALLOW_PLAIN_HTTP=

# HTTPS in the server: the certificate (with its chain) and the key, as the
# container sees them (mount the folder in compose.yaml). Both or neither.
# Neither: the server serves plain HTTP, for a proxy in front or a try.
CROMDB_TLS_CERT=
CROMDB_TLS_KEY=

# yes if a reverse proxy in front serves HTTPS: the server then trusts its
# X-Forwarded headers. no if not set.
CROMDB_TRUST_PROXY=

# The login provider's issuer URL, the SAME address for the server in its
# container and for people's browsers. Not localhost: inside the container
# that is the container. For Keycloak, https://HOST/realms/REALM.
CROMDB_ISSUER=

# The client at the login provider.
CROMDB_CLIENT_ID=cromdb

# The client's secret. Set this OR CROMDB_CLIENT_SECRET_FILE, not both.
# After the first start the secret is kept in the server's database, and
# this line is not used again: remove the secret from this file then.
# To replace it later, use the admin UI's Settings page.
CROMDB_CLIENT_SECRET=

# Or a file holding the secret, as the container sees it, such as a Compose
# secret: /run/secrets/client_secret (see compose.yaml). Then the secret is
# never in this file.
CROMDB_CLIENT_SECRET_FILE=

# The first server admin. They log in with this email, which the login
# provider must have VERIFIED, and invite everyone else from the admin UI.
CROMDB_ADMIN_EMAIL=
