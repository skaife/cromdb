{
  "name": "@cromdb/server",
  "version": "0.2.0",
  "private": true,
  "description": "CromDB Server: serves CromDB databases to people over HTTP, through a CromDB driver.",
  "license": "MIT",
  "author": "Scott Skaife <crom@skaife.org>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cromdb-server": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --dir test",
    "test:keycloak": "node scripts/keycloak.mjs",
    "dev:server": "node scripts/dev-server.ts"
  },
  "dependencies": {
    "@cromdb/admin-ui": "0.1.0",
    "@cromdb/driver": "0.3.0",
    "@cromdb/driver-level-4": "0.2.0",
    "ajv": "^8.20.0",
    "express": "^5.3.0",
    "openid-client": "6.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "fast-check": "^4.10.2",
    "jose": "^6.2.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
